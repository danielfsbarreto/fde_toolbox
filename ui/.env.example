# Review app (ui/). Copy to ui/.env for local runs (bin/start reads it); on Heroku these are the app's config
# vars, one for one, except NGROK_DOMAIN. The app never calls AMP's API: AMP sends it each review pause by
# webhook, and the app answers on the callback URL that comes with it.

# --- Database (the same one the AMP flow uses) -------------------------------------------------------------------

MONGODB_CONNECTION_STRING=
MONGODB_DATABASE=fde_activity_log
# Whose days this app reviews (default daniel-barreto)
# FDE_ID=daniel-barreto

# --- AMP webhook -------------------------------------------------------------------------------------------------

# In AMP: Deployment > Settings > Human in the Loop > Webhooks, add https://<app>/api/hitl/webhook and copy its
# signing secret here
HITL_WEBHOOK_SECRET=

# --- Sign-in (GitHub OAuth app: Settings > Developer settings > OAuth Apps) ----------------------------------------

# One OAuth app per URL: homepage https://<app>, callback https://<app>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub logins allowed in, comma-separated
REVIEW_UI_GITHUB_USERS=

# --- Secrets (`bin/start --secrets` prints fresh ones; keep the same values on Heroku) ----------------------------

# Signs the session cookie
SESSION_SECRET=
# Encrypts AMP's callback URLs at rest (changing it makes waiting reviews unanswerable from the app)
CALLBACK_ENCRYPTION_KEY=
# Encrypts builds' env var values (the project builder's sandbox keys); the project builder flow needs the same
# value (flows/project_builder/.env and its AMP deployment). Changing it makes the stored values unreadable.
BUILD_ENV_KEY=

# The account report flow on AMP (optional): with both set, "Write the report" starts it there. Without them,
# reports are saved and their page shows the command to run them locally (bin/flow account_report kickoff ...).
# The URL and the bearer token are on the deployment's Status tab in AMP.
AMP_REPORT_URL=
AMP_REPORT_TOKEN=

# The project builder flow on AMP (optional): with both set, the Builds tab sends each message there as a chat turn.
# Without them, messages wait in MongoDB for a local worker (bin/flow project_builder worker).
AMP_BUILDER_URL=
AMP_BUILDER_TOKEN=

# --- Local only ---------------------------------------------------------------------------------------------------

# Your ngrok domain (dashboard > Domains); bin/start serves the app there. Never set it on Heroku:
# where it is set, the app shows the DEV bar on top.
NGROK_DOMAIN=
