# The account report flow (flows/account_report). Copy to .env for local runs; on AMP these are the deployment's
# env vars. It reads the final daily logs and writes reports; it never collects from sources.
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE=fde_activity_log
ANTHROPIC_API_KEY=
# Optional: the follow-ups' Todoist status (open or completed) in the report
TODOIST_API_KEY=
CREWAI_TRACING_ENABLED=true
# REPORT_LLM_MODEL=anthropic/claude-opus-5-5
