# The project builder flow (flows/project_builder). Copy to .env for local runs; on AMP these are the deployment's
# env vars. It holds the builds' conversations and artifacts in MongoDB; generated code runs only in E2B sandboxes.
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE=fde_activity_log
ANTHROPIC_API_KEY=
# The managed sandboxes that write, install and test the generated projects
E2B_API_KEY=
# Optional: lets a design check which AMP platform integrations (Gmail, Slack, ...) your account has connected
CREWAI_PLATFORM_INTEGRATION_TOKEN=
# Optional: web search for the architect, for external APIs and libraries (Exa)
EXA_API_KEY=
# Decrypts builds' env var values for their sandboxes: the same value as the review app's BUILD_ENV_KEY
BUILD_ENV_KEY=
CREWAI_TRACING_ENABLED=true
# BUILDER_LLM_MODEL=anthropic/claude-opus-5-5
# ROUTER_LLM_MODEL=anthropic/claude-haiku-5-5
# ENGINEER_LLM_MODEL=anthropic/claude-sonnet-5-5
