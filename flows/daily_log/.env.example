# The daily log flow (flows/daily_log). Copy to .env for local runs; on AMP these are the deployment's env vars
# (`crewai deploy create` uploads this file). The review app has its own file: ui/.env.example.

# --- Required ------------------------------------------------------------------------------------------------

# MongoDB Atlas (the review app uses the same database)
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE=fde_activity_log

# The FDE's own CrewAI Enterprise token (app.crewai.com > Settings > Account): every source is read through
# this FDE's AMP connections
CREWAI_PLATFORM_INTEGRATION_TOKEN=

# LLM provider
ANTHROPIC_API_KEY=

# --- Review app link ------------------------------------------------------------------------------------------

# Where the review app runs (Heroku, or the ngrok domain while developing). The review message links to the day
# there. AMP also needs the app's webhook (https://<app>/api/hitl/webhook) under Deployment > Settings >
# Human in the Loop > Webhooks; that one is a setting in AMP, not an env var.
REVIEW_UI_URL=

# --- Integrations (optional) ----------------------------------------------------------------------------------

# Todoist: the FDE's API token (Settings > Integrations > Developer). Each final day's action points go to the
# projects/sections set by the `todoist` rows in the profile. Empty: nothing is sent.
TODOIST_API_KEY=

# --- Observability --------------------------------------------------------------------------------------------

# Record a trace for every run
CREWAI_TRACING_ENABLED=true

# --- Tuning (defaults shown; uncomment to change) -------------------------------------------------------------

# AMP connection alias or UUID for every app (default: the token owner's private connections)
# AMP_CONNECTION=private
# AMP_RETRY_ATTEMPTS=4
# AMP_RETRY_BACKOFF_S=2.0
# LLM_MODEL=anthropic/claude-sonnet-5-5           # grouping, writing, action points
# REVIEW_LLM_MODEL=anthropic/claude-opus-5-5      # the deep review agent (review requests)
# EVENT_RETENTION_DAYS=90
# TEXT_MAX_CHARS=2000
# MEETING_TEXT_MAX_CHARS=8000
# COLLECTOR_TIMEOUT_S=240
# GROUPING_MAX_CHARS=160000
# COLLECTION_SETTLE_HOURS=2
# REFERENCE_CACHE_DAYS=7
# Fetch every source again for the run's days, ignoring what is stored (local use only; keep it off on AMP)
# FORCE_RECOLLECT=false
